{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "declaration": true,
        "emitDeclarationOnly": false,
        "outDir": "dist/webclient",
        "rootDir": ".",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": false
    },
    "include": [
        "webui/src/client/**/*.ts"
    ]
}